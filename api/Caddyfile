{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# The UI lives under /dolphinscheduler/ui/
	redir / /dolphinscheduler/ui/ 302

	# Only the health endpoint of Spring's actuator is public
	@actuator {
		path /dolphinscheduler/actuator /dolphinscheduler/actuator/*
		not path /dolphinscheduler/actuator/health
	}
	respond @actuator 404

	reverse_proxy 127.0.0.1:12345
}
